# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=5lcdhip2
NEXT_PUBLIC_SANITY_DATASET=production

# PostHog analytics (public ingest key — safe in client bundle)
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Apps Script endpoint for contact / expert forms
NEXT_PUBLIC_GOOGLE_SCRIPT_CONTACT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional: search engine site-verification tokens (already hardcoded in deploy.yml for prod)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
